# Copy this file to .env. .env is never committed.
# Only the Groq zero-shot run needs a key. The tests and the other systems do not.
# Create a free key in the Groq console (console.groq.com) and check the current model names and rate limits there.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional second zero-shot row: Z.ai GLM-4.7-Flash (free). Create a key at https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
